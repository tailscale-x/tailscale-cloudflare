FROM --platform=$BUILDPLATFORM golang:1.26.5 AS build
ARG VERSION=dev
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum* ./
COPY third_party/caddy-docker-proxy ./third_party/caddy-docker-proxy
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -tags caddy -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/tailscale-private-funnel ./cmd/tailscale-private-funnel

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/tailscale-private-funnel /usr/local/bin/tailscale-private-funnel
ENV HOME=/data XDG_DATA_HOME=/data XDG_CONFIG_HOME=/data/config
ENTRYPOINT ["/usr/local/bin/tailscale-private-funnel"]
