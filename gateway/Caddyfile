{
	email {$ACME_EMAIL}
	tailscale {
		state_dir /state/tsnet
		gateway {
			hostname {$TS_HOSTNAME}
			auth_key {$TS_AUTHKEY}
		}
	}
	on_demand_tls {
		ask http://127.0.0.1:9123/
	}
}

# Caddy requires a permission endpoint for catch-all on-demand TLS. This local
# endpoint deliberately approves every name and has no dependency on the Worker.
http://127.0.0.1:9123 {
	respond 200
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy {
		dynamic srv _gateway._tcp.{host} {
			refresh 1m
		}
		transport tailscale gateway
	}
}

# Opening this tailnet-only listener joins the embedded node at startup.
:9080 {
	bind tailscale/gateway
	respond 200
}
